<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- list/List View -->
        <record id="view_riwayat_shift_list" model="ir.ui.view">
            <field name="name">riwayat.shift.karyawan.list</field>
            <field name="model">riwayat.shift.karyawan</field>
            <field name="arch" type="xml">
                <list string="Riwayat Shift">
                    <field name="tanggal"/>
                    <field name="karyawan_id"/>
                    <field name="shift_type"/>
                    <field name="status_kehadiran"/>
                    <field name="kehadiran_id"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_riwayat_shift_form" model="ir.ui.view">
            <field name="name">riwayat.shift.karyawan.form</field>
            <field name="model">riwayat.shift.karyawan</field>
            <field name="arch" type="xml">
                <form string="Riwayat Shift">
                    <sheet>
                        <group>
                            <field name="tanggal" readonly="1"/>
                            <field name="karyawan_id" readonly="1"/>
                            <field name="shift_type" readonly="1"/>
                            <field name="status_kehadiran" readonly="1"/>
                            <field name="kehadiran_id" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_riwayat_shift_search" model="ir.ui.view">
            <field name="name">riwayat.shift.karyawan.search</field>
            <field name="model">riwayat.shift.karyawan</field>
            <field name="arch" type="xml">
                <search>
                    <field name="karyawan_id"/>
                    <field name="tanggal"/>

                      <!-- Filter Status -->
                    <filter name="filter_hadir" string="Hadir" domain="[('status_kehadiran','=','hadir')]"/>
                    <filter name="filter_alfa" string="Alfa" domain="[('status_kehadiran','=','alfa')]"/>
                    <filter name="filter_lembur" string="Lembur" domain="[('status_kehadiran','=','izin_lembur')]"/>

                </search>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="view_riwayat_shift_kanban" model="ir.ui.view">
            <field name="name">riwayat.shift.karyawan.kanban</field>
            <field name="model">riwayat.shift.karyawan</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column" string="Riwayat Shift">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_title">
                                    <strong><field name="karyawan_id"/></strong>
                                </div>
                                <div>
                                    <field name="tanggal"/>
                                </div>
                                <div>
                                    <field name="kehadiran_id"/>
                                </div>
                                <div>
                                    <field name="status_kehadiran"/>
                                </div>
                                <div>
                                    <span class="badge badge-primary"><field name="shift_type"/></span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <!-- Action -->
        <record id="action_riwayat_shift" model="ir.actions.act_window">
            <field name="name">Riwayat Shift</field>
            <field name="res_model">riwayat.shift.karyawan</field>
            <field name="view_mode">list,form,kanban</field>
            <field name="search_view_id" ref="view_riwayat_shift_search"/>
            <field name="context">{'create': False}</field>
        </record>


    </data>
</odoo>
