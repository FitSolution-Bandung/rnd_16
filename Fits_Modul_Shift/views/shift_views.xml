<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

           <!-- Kanban View -->
        <record id="view_shift_kanban" model="ir.ui.view">
            <field name="name">shift.karyawan.kanban</field>
            <field name="model">shift.karyawan</field>
            <field name="arch" type="xml">
                <kanban default_group_by="jenis_shift"
                        class="o_kanban_small_column"
                        string="Daftar Shift">
                    
                    <field name="warna"/>
                    <field name="jam_mulai"/>
                    <field name="jam_selesai"/>
                    <field name="lintas_hari"/>
                    <field name="jenis_shift"/>
                    <field name="karyawan_ids"/>

                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_color_#{record.warna.value or '0'} 
                                               o_kanban_record my-kanban-box">
                                <div class="o_kanban_details">
                                    
                                    <!-- Header -->
                                    <div class="kanban-header">
                                        <strong>
                                            <field name="name"/>
                                        </strong>
                                    </div>

                                    <!-- Body -->
                                    <div class="kanban-body">
                                        <div>
                                            <i class="fa fa-clock-o"/> 
                                            Jam: 
                                            <field name="jam_mulai" widget="float_time"/> - 
                                            <field name="jam_selesai" widget="float_time"/>
                                            <field name="lintas_hari"/>
                                        </div>
                                        <div>
                                            <i class="fa fa-sun-o"/> 
                                            Jenis: 
                                            <field name="jenis_shift"/>
                                        </div>
                                        <div>
                                            <i class="fa fa-ban"/> 
                                            No Female: 
                                            <field name="no_female"/>
                                        </div>
                                        <div>
                                            <i class="fa fa-users"/> 
                                            Karyawan: 
                                            <field name="karyawan_ids" widget="many2many_tags"/>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- List View -->
        <record id="view_shift_list" model="ir.ui.view">
            <field name="name">shift.karyawan.list</field>
            <field name="model">shift.karyawan</field>
            <field name="arch" type="xml">
                <list string="Daftar Shift">
                    <field name="name"/>
                    <field name="jam_mulai" widget="float_time"/>
                    <field name="jam_selesai" widget="float_time"/>
                    <field name="jenis_shift"/>
                    <field name="aktif"/>
                    <field name="warna" widget="color_picker"/>
                    <field name="no_female"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_shift_form" model="ir.ui.view">
            <field name="name">shift.karyawan.form</field>
            <field name="model">shift.karyawan</field>
            <field name="arch" type="xml">
                <form string="Detail Shift">
                    <sheet groups="Fits_Modul_Shift.group_shifting_manager">
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="jenis_shift"/>
                                <field name="aktif"/>
                                <field name="warna" widget="color_picker"/>     
                            </group>
                            <group>
                                <field name="jam_mulai" widget="float_time"/>
                                <field name="jam_selesai" widget="float_time"/>
                                <field name="lintas_hari"/>
                                <field name="no_female"/> 
                                <field name="is_middle"/>
                                    <field name="allowed_days" 
                                            widget="many2many_tags"
                                            invisible="not show_allowed_days"/>
                            </group>
                        </group>

                        <group>
                            <field name="deskripsi"
                                   placeholder="Deskripsi shift..."/>
                        </group>

                        <!-- <notebook>
                             <page string="Jadwal">
                                <field name="jadwal_ids">
                                    <list>
                                        <field name="employee_id"/>
                                        <field name="tanggal"/>
                                        <field name="status"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Karyawan Hari Ini">
                                <field name="karyawan_ids" widget="many2many_tags"/>
                                <div class="alert alert-info">
                                    <i class="fa fa-info-circle"/> 
                                    Daftar karyawan yang check-in hari ini sesuai dengan jam shift ini.
                                </div>
                            </page>
                        </notebook> -->
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_shift" model="ir.actions.act_window">
            <field name="name">Shift Config</field>
            <field name="res_model">shift.karyawan</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'default_aktif': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add shift data here
                </p>
            </field>
        </record>

    </data>
</odoo>
