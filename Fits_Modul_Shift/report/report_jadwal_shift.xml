<?xml version="1.0" encoding="UTF-8"?>
<odoo>
       <template id="report_jadwal_shift_template">
        <t t-call="web.basic_layout">
            <t t-set="title">Jadwal Shift Karyawan</t>
            <div class="page">
                <h2 style="text-align:center; margin-bottom:5px;">Shifting Schedule</h2>

                <!-- Tampilkan periode -->
                <t t-set="periode_start" t-value="docs and min([rec.tanggal for rec in docs]) or False"/>
                <t t-set="periode_end" t-value="docs and max([rec.tanggal for rec in docs]) or False"/>

                <!-- Tampilkan nama bulan di atas periode -->
                <t t-if="periode_start">
                    <p style="text-align:center; font-weight:bold; font-size:16px; margin-bottom:5px;">
                        <t t-esc="periode_start.strftime('%B')"/>
                    </p>
                </t>

                <p style="text-align:center; margin-bottom:20px;">
                    <t t-esc="periode_start.strftime('%d/%m/%Y') if periode_start else ''"/> - 
                    <t t-esc="periode_end.strftime('%d/%m/%Y') if periode_end else ''"/>
                </p>

                <!-- Tentukan jumlah employee unik -->
                <t t-set="employee_list" t-value="docs.mapped('employee_id')"/>
                
               <!-- Jika hanya 1 employee, tampilkan versi kolom sejajar per shift -->
               <t t-if="len(employee_list) == 1">
                <t t-set="employee" t-value="employee_list[0]"/>
                <div style="margin-bottom:30px;">
                    <h3 style="margin-bottom:15px;">
                        <t t-esc="employee.name"/>
                    </h3>

                    <t t-set="employee_recs" t-value="docs.filtered(lambda r: r.employee_id == employee)"/>
                    <t t-set="shift_list" t-value="[rec.shift_id for rec in employee_recs if rec.shift_id]"/>
                    <t t-set="unique_shifts" t-value="sorted(list(dict.fromkeys(shift_list)), key=lambda s: (0 if 'Pagi' in s.name else (1 if 'Sore' in s.name else 2)))"/>

                    <!-- Gunakan tabel agar PDF bisa tampil sejajar -->
                    <table class="table table-bordered" style="width:100%; border-collapse: collapse; margin-bottom:20px;">
                        <tr>
                            <t t-foreach="unique_shifts" t-as="shift">
                                <t t-set="jam_mulai" t-value="int(shift.jam_mulai)"/>
                                <t t-set="menit_mulai" t-value="int(round((shift.jam_mulai - jam_mulai)*60))"/>
                                <t t-set="jam_selesai" t-value="int(shift.jam_selesai)"/>
                                <t t-set="menit_selesai" t-value="int(round((shift.jam_selesai - jam_selesai)*60))"/>

                                <td style="vertical-align:top; border:1px solid #111; border-radius:5px; padding:5px;">
                                    <h4 style="background:#f7f7f7; text-align:center; padding:6px; font-weight:bold; font-size:17px;">
                                        <t t-esc="f'{shift.name} ({jam_mulai:02d}:{menit_mulai:02d}-{jam_selesai:02d}:{menit_selesai:02d})'"/>
                                    </h4>


                                    <table style="width:100%; border-collapse:collapse;">
                                        <tbody>
                                            <t t-foreach="employee_recs.filtered(lambda r: r.shift_id == shift)" t-as="rec">
                                                <tr>
                                                    <td style="padding:5px; text-align:center;">
                                                        <t t-esc="rec.tanggal.strftime('%d/%m')"/>
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="len(employee_recs.filtered(lambda r: r.shift_id == shift)) == 0">
                                                <tr><td style="padding:5px; text-align:center; color:#999; font-style:italic;">No data</td></tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </td>
                            </t>
                        </tr>
                    </table>
                </div>
            </t>

                <!-- Jika lebih dari 1 employee, tampilkan versi tabel mingguan per tanggal -->
                <t t-else="">
                    <!-- Persiapkan jadwal per karyawan -->
                    <t t-set="jadwal_karyawan" t-value="{}"/>
                    <t t-foreach="docs" t-as="rec">
                        <t t-set="employee_name" t-value="rec.employee_id.name"/>
                        <t t-set="shift_name" t-value="rec.shift_id.name or ''"/>
                        <t t-set="jam_mulai" t-value="int(rec.shift_id.jam_mulai) if rec.shift_id.jam_mulai else 0"/>
                        <t t-set="menit_mulai" t-value="int(round((rec.shift_id.jam_mulai - jam_mulai)*60)) if rec.shift_id.jam_mulai else 0"/>
                        <t t-set="jam_selesai" t-value="int(rec.shift_id.jam_selesai) if rec.shift_id.jam_selesai else 0"/>
                        <t t-set="menit_selesai" t-value="int(round((rec.shift_id.jam_selesai - jam_selesai)*60)) if rec.shift_id.jam_selesai else 0"/>
                        <t t-set="shift_full" t-value="f'{shift_name} ({jam_mulai:02d}:{menit_mulai:02d}-{jam_selesai:02d}:{menit_selesai:02d})'"/>
                        <t t-if="employee_name not in jadwal_karyawan">
                            <t t-set="jadwal_karyawan" t-value="jadwal_karyawan.update({employee_name: {}}) or jadwal_karyawan"/>
                        </t>
                        <t t-set="jadwal_karyawan" t-value="jadwal_karyawan.update({employee_name: jadwal_karyawan[employee_name].update({rec.tanggal: shift_full}) or jadwal_karyawan[employee_name]}) or jadwal_karyawan"/>
                    </t>

                    <!-- Ambil semua tanggal unik untuk sorting -->
                    <t t-set="all_dates" t-value="sorted(set([rec.tanggal for rec in docs]))"/>

                    <!-- Grup per minggu -->
                    <t t-set="weeks" t-value="[]"/>
                    <t t-set="current_week_num" t-value="0"/>
                    <t t-set="current_week_dates" t-value="[]"/>
                    <t t-foreach="all_dates" t-as="date">
                        <t t-set="week_num" t-value="date.isocalendar()[1]"/>
                        <t t-if="week_num != current_week_num">
                            <t t-if="current_week_dates">
                                <t t-set="weeks" t-value="weeks + [(current_week_num, current_week_dates)]"/>
                            </t>
                            <t t-set="current_week_num" t-value="week_num"/>
                            <t t-set="current_week_dates" t-value="[date]"/>
                        </t>
                        <t t-else="">
                            <t t-set="current_week_dates" t-value="current_week_dates + [date]"/>
                        </t>
                    </t>
                    <t t-if="current_week_dates">
                        <t t-set="weeks" t-value="weeks + [(current_week_num, current_week_dates)]"/>
                    </t>

                    <!-- Render tabel per minggu -->
                    <t t-foreach="weeks" t-as="week">
                        <t t-set="week_num" t-value="week[0]"/>
                        <t t-set="week_dates" t-value="week[1]"/>
                        <h3 style="margin-top:20px;">Minggu ke-<t t-esc="week_num"/></h3>
                        <table class="table table-bordered" style="width:100%; border-collapse: collapse; margin-bottom:20px;">
                            <thead>
                                <tr style="background-color: #f2f2f2;">
                                    <th style="border:1px solid #000; padding:5px;">Employee</th>
                                    <t t-foreach="week_dates" t-as="date_col">
                                        <th style="border:1px solid #000; padding:5px;">
                                            <t t-esc="date_col.strftime('%d/%m')"/>
                                        </th>
                                    </t>
                                </tr>
                                <!-- <tr style="background-color: #e6e6e6;">
                                    <th style="border:1px solid #000; padding:5px;">Days</th>
                                    <t t-foreach="week_dates" t-as="date_col">
                                        <th style="border:1px solid #000; padding:5px;">
                                            <t t-esc="date_col.strftime('%A')"/>
                                        </th>
                                    </t>
                                </tr> -->
                            </thead>
                            <tbody>
                                <t t-foreach="jadwal_karyawan.items()" t-as="item">
                                    <tr>
                                        <td style="border:1px solid #000; padding:5px;">
                                            <t t-esc="item[0]"/>
                                        </td>
                                        <t t-foreach="week_dates" t-as="date_col">
                                            <td style="border:1px solid #000; padding:5px;">
                                                <t t-set="shift_val" t-value="item[1].get(date_col, '')"/>
                                                <t t-if="shift_val">
                                                    <t t-esc="shift_val"/>
                                                </t>
                                                <t t-else="" >
                                                    <span style="color:red; font-weight:bold;">Off Days</span>
                                                </t>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <!-- Report Action -->
    <record id="action_report_jadwal_shift" model="ir.actions.report">
        <field name="name">Jadwal Shift</field>
        <field name="model">jadwal.shift.karyawan</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">Fits_Modul_Shift.report_jadwal_shift_template</field>
        <field name="print_report_name">'Jadwal Shift - %s' % (object.tanggal)</field>
    </record>
</odoo>
